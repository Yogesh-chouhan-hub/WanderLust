<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Edit Listing</title>
    <link rel="stylesheet" href="/style.css" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
    />
  </head>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      overflow-x: hidden;
      background: #f5f7fb;
    }

    /* ================= FORM ================= */

    .form-container {
      width: 100%;
      max-width: 520px;

      margin: 40px auto;

      background: white;

      padding: 28px;

      border-radius: 18px;

      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
    }

    .form-container h2 {
      text-align: center;

      margin-bottom: 22px;

      font-size: 30px;
    }

    /* ================= INPUTS ================= */

    .form-container input,
    .form-container textarea {
      width: 100%;

      padding: 13px 14px;

      margin-bottom: 16px;

      border: 1px solid #ddd;

      border-radius: 10px;

      font-size: 15px;

      outline: none;
    }

    .form-container textarea {
      min-height: 120px;

      resize: none;
    }

    /* ================= IMAGE ================= */

    .current-img {
      width: 100%;

      max-width: 300px;

      height: 220px;

      object-fit: cover;

      border-radius: 14px;

      margin-bottom: 18px;
    }

    /* ================= BUTTON ================= */

    .form-container button {
      width: 100%;

      padding: 14px;

      border: none;

      background: linear-gradient(135deg, #ff385c, #ff7a18);

      color: white;

      font-size: 16px;

      border-radius: 12px;

      cursor: pointer;

      transition: 0.3s ease;
    }

    .form-container button:hover {
      transform: translateY(-2px);
    }

    /* ================= TABLET ================= */

    @media (max-width: 768px) {
      .form-container {
        margin: 30px 16px;

        padding: 24px;
      }

      .form-container h2 {
        font-size: 26px;
      }

      .current-img {
        max-width: 100%;
        height: 200px;
      }
    }

    /* ================= MOBILE ================= */

    @media (max-width: 480px) {
      .form-container {
        margin: 20px 12px;

        padding: 18px;
      }

      .form-container h2 {
        font-size: 22px;
      }

      .form-container input,
      .form-container textarea {
        font-size: 14px;

        padding: 12px;
      }

      .form-container button {
        font-size: 15px;
        padding: 12px;
      }

      .current-img {
        height: 180px;
      }
    }
  </style>
  <body>
    <%- include("include/navbar.ejs") %> <%- include("include/flash.ejs") %>

    <div class="form-container">
      <h2>Edit Listing</h2>

      <form
        method="POST"
        action="/listing/edit/<%= info._id %>?_method=PATCH"
        enctype="multipart/form-data"
      >
        <input type="text" name="title" value="<%= info.title %>" required />

        <textarea name="description" required><%= info.description %></textarea>

        <p>Current Image:</p>

        <img
          class="current-img"
          src="<%= info.image.url.replace('/upload', '/upload/w_300,h_200,c_fill,q_auto,f_auto') %>"
          alt="Current Image"
        />

        <input type="file" name="image" />

        <input type="number" name="price" value="<%= info.price %>" required />

        <input
          type="text"
          name="location"
          value="<%= info.location %>"
          required
        />

        <input
          type="text"
          name="country"
          value="<%= info.country %>"
          required
        />

        <button type="submit">Update Listing</button>
      </form>
    </div>

    <%- include("include/footer.ejs") %>
  </body>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

  <script src="/script.js"></script>
</html>
