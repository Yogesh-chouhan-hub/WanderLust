<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Edit Listing</title>

    <link rel="stylesheet" href="/style.css" />

    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
    />

    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        background: #f5f7fb;
        overflow-x: hidden;
      }

      /* ================= PAGE ================= */

      .edit-page {
        width: 100%;

        display: flex;

        justify-content: center;

        padding: 40px 16px 60px;
      }

      /* ================= FORM CARD ================= */

      .form-container {
        width: 100%;

        max-width: 540px;

        background: white;

        padding: 28px;

        border-radius: 20px;

        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
      }

      .form-container h2 {
        text-align: center;

        margin-bottom: 24px;

        font-size: 32px;

        font-weight: 700;

        color: #111827;
      }

      /* ================= INPUTS ================= */

      .form-container input,
      .form-container textarea {
        width: 100%;

        border: 1px solid #ddd;

        border-radius: 12px;

        padding: 13px 14px;

        margin-bottom: 16px;

        font-size: 15px;

        outline: none;

        background: white;
      }

      .form-container textarea {
        resize: none;

        min-height: 120px;
      }

      .form-container input:focus,
      .form-container textarea:focus {
        border-color: #ff385c;

        box-shadow: 0 0 0 4px rgba(255, 56, 92, 0.12);
      }

      /* ================= IMAGE ================= */

      .image-label {
        margin-bottom: 10px;

        font-weight: 600;

        color: #374151;
      }

      .current-img {
        width: 100%;

        max-width: 100%;

        height: 240px;

        object-fit: cover;

        border-radius: 16px;

        margin-bottom: 18px;
      }

      /* ================= BUTTON ================= */

      .update-btn {
        width: 100%;

        border: none;

        padding: 14px;

        border-radius: 14px;

        background: linear-gradient(135deg, #ff385c, #ff7a18);

        color: white;

        font-size: 16px;

        font-weight: 600;

        cursor: pointer;

        transition: 0.3s ease;
      }

      .update-btn:hover {
        transform: translateY(-2px);
      }

      /* ================= TABLET ================= */

      @media (max-width: 768px) {
        .edit-page {
          padding: 30px 14px 50px;
        }

        .form-container {
          padding: 24px;
        }

        .form-container h2 {
          font-size: 28px;
        }

        .current-img {
          height: 210px;
        }
      }

      /* ================= MOBILE ================= */

      @media (max-width: 480px) {
        .edit-page {
          padding: 24px 10px 40px;
        }

        .form-container {
          padding: 18px;
          border-radius: 16px;
        }

        .form-container h2 {
          font-size: 24px;
        }

        .form-container input,
        .form-container textarea {
          font-size: 14px;

          padding: 12px;
        }

        .current-img {
          height: 180px;
        }

        .update-btn {
          padding: 12px;
          font-size: 15px;
        }
      }
    </style>
  </head>

  <body>
    <%- include("include/navbar.ejs") %> <%- include("include/flash.ejs") %>

    <section class="edit-page">
      <div class="form-container">
        <h2>Edit Listing</h2>

        <form
          method="POST"
          action="/listing/edit/<%= info._id %>?_method=PATCH"
          enctype="multipart/form-data"
        >
          <input type="text" name="title" value="<%= info.title %>" required />

          <textarea name="description" required>
<%= info.description %></textarea
          >

          <p class="image-label">Current Image</p>

          <img
            class="current-img"
            src="<%= info.image.url.replace('/upload', '/upload/w_600,h_400,c_fill,q_auto,f_auto') %>"
            alt="Current Image"
          />

          <input type="file" name="image" />

          <input
            type="number"
            name="price"
            value="<%= info.price %>"
            required
          />

          <input
            type="text"
            name="location"
            value="<%= info.location %>"
            required
          />

          <input
            type="text"
            name="country"
            value="<%= info.country %>"
            required
          />

          <button type="submit" class="update-btn">Update Listing</button>
        </form>
      </div>
    </section>

    <%- include("include/footer.ejs") %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

    <script src="/script.js"></script>
  </body>
</html>
