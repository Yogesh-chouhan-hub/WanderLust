<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Beautiful Signup Form</title>

    <!-- Google Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: "Poppins", sans-serif;

        min-height: 100vh;

        display: flex;
        flex-direction: column;
        justify-content: space-evenly;
        align-items: center;
        color: #f1f1f1;
        background: linear-gradient(135deg, #0f0f0f, #171717, #1f1f1f);

        overflow: hidden;

        padding: 20px;

        position: relative;
      }

      /* Elegant Background Glow */

      body::before,
      body::after {
        content: "";

        position: absolute;

        width: 320px;
        height: 320px;

        border-radius: 50%;

        filter: blur(120px);

        z-index: 0;
      }

      body::before {
        background: rgba(255, 59, 92, 0.18);

        top: -100px;
        left: -100px;
      }

      body::after {
        background: rgba(255, 255, 255, 0.06);

        bottom: -100px;
        right: -100px;
      }

      /* ================= CONTAINER ================= */

      .signup-container {
        position: relative;
        z-index: 1;

        width: 100%;
        max-width: 430px;

        background: rgba(255, 255, 255, 0.06);

        border: 1px solid rgba(255, 255, 255, 0.08);

        backdrop-filter: blur(18px);

        border-radius: 28px;

        padding: 45px 35px;

        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.45);

        animation: fadeIn 0.6s ease;
      }

      @keyframes fadeIn {
        from {
          opacity: 0;
          transform: translateY(20px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      /* ================= HEADING ================= */

      .signup-container h2 {
        text-align: center;

        color: #ffffff;

        font-size: 34px;
        font-weight: 700;

        margin-bottom: 10px;

        letter-spacing: 0.5px;
      }

      .signup-container p {
        text-align: center;

        color: #bdbdbd;

        font-size: 14px;

        margin-bottom: 35px;
      }

      /* ================= INPUTS ================= */

      .input-group {
        margin-bottom: 22px;
      }

      .input-group label {
        display: block;

        margin-bottom: 8px;

        color: #f1f1f1;

        font-size: 14px;
        font-weight: 500;
      }

      .input-group input {
        width: 100%;

        padding: 14px 16px;

        border-radius: 14px;

        border: 1px solid rgba(255, 255, 255, 0.08);

        outline: none;

        background: #1a1a1a;

        color: white;

        font-size: 15px;

        transition: 0.3s ease;
      }

      .input-group input::placeholder {
        color: #8f8f8f;
      }

      .input-group input:focus {
        border-color: #ff385c;

        box-shadow: 0 0 0 4px rgba(255, 56, 92, 0.12);
      }

      /* ================= BUTTON ================= */

      .signup-btn {
        width: 100%;

        padding: 14px;

        border: none;
        outline: none;

        border-radius: 16px;

        background: linear-gradient(135deg, #ff385c, #ff4d6d);

        color: white;

        font-size: 16px;
        font-weight: 600;

        cursor: pointer;

        transition: 0.35s ease;

        margin-top: 8px;
      }

      .signup-btn:hover {
        transform: translateY(-3px);

        box-shadow: 0 10px 25px rgba(255, 56, 92, 0.35);
      }

      /* ================= BOTTOM TEXT ================= */

      .bottom-text {
        text-align: center;

        margin-top: 24px;

        color: #bcbcbc;

        font-size: 14px;
      }

      .bottom-text a {
        color: #ffffff;

        text-decoration: none;

        font-weight: 600;

        transition: 0.3s;
      }

      .bottom-text a:hover {
        color: #ff385c;
      }

      /* ================= RESPONSIVE ================= */

      @media (max-width: 500px) {
        .signup-container {
          padding: 35px 22px;
        }

        .signup-container h2 {
          font-size: 28px;
        }

        .input-group input {
          padding: 13px 14px;
        }
      }
    </style>
  </head>
  <body>
    <%- include("include/flash.ejs") %>
    <div class="signup-container">
      <h2>Create Account</h2>
      <p>Join WanderLust and explore the world</p>

      <form method="post" action="/signup">
        <div class="input-group">
          <label>User Name</label>
          <input
            name="username"
            type="text"
            placeholder="Enter your User name"
            required
          />
        </div>

        <div class="input-group">
          <label>Email Address</label>
          <input
            name="email"
            type="email"
            placeholder="Enter your email"
            required
          />
        </div>

        <div class="input-group">
          <label>Password</label>
          <input
            name="password"
            type="password"
            placeholder="Create password"
            required
          />
        </div>

        <button class="signup-btn">Create Account</button>
      </form>

      <div class="bottom-text">
        Already have an account?
        <a href="/signin">Sign-in</a>
      </div>
    </div>
  </body>
</html>
