<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WanderLust</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="/rating.css">
    <link
rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css"
/>
</head>
<style>
    @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');

/* ================= RESET ================= */
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:'Poppins',sans-serif;
    background:#f5f7fb;
    color:#222;
}

/* ================= HEADING ================= */
.heading{
    text-align:center;
    margin:40px 0 10px;
    font-size:34px;
    font-weight:700;
    color:#222;
    position:relative;
}

.heading::after{
    content:"";
    width:90px;
    height:4px;
    background:#ff385c;
    display:block;
    margin:10px auto 0;
    border-radius:10px;
}

/* ================= GRID ================= */
.grid{
    width:100%;
    max-width:1300px;

    margin:auto;

    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(280px,1fr));

    gap:32px;

    padding:40px 30px 70px;
}

/* ================= CARD ================= */
.card{
    background:white;

    border-radius:24px;

    overflow:hidden;

    position:relative;

    transition:0.35s ease;

    box-shadow:
        0 10px 30px rgba(0,0,0,0.06);

    display:flex;
    flex-direction:column;

    height:100%;
}

.card:hover{
    transform:translateY(-10px);

    box-shadow:
        0 18px 40px rgba(0,0,0,0.14);
}

/* ================= FULL LINK ================= */
.card-link{
    text-decoration:none;
    color:inherit;

    display:flex;
    flex-direction:column;

    flex-grow:1;
}

/* ================= IMAGE ================= */
.card-img{
    position:relative;
    overflow:hidden;
}

.card-img img{
    width:100%;
    height:240px;

    object-fit:cover;

    transition:0.5s ease;
}

.card:hover .card-img img{
    transform:scale(1.08);
}

/* Dark overlay */
.card-img::after{
    content:"";

    position:absolute;
    inset:0;

    background:linear-gradient(
        to top,
        rgba(0,0,0,0.45),
        transparent 50%
    );

    opacity:0;

    transition:0.3s;
}

.card:hover .card-img::after{
    opacity:1;
}

/* ================= CARD BODY ================= */
.card-body{
    padding:20px 22px 10px;
    flex-grow:1;
}

.card-body h3{
    font-size:22px;
    margin-bottom:10px;

    color:#222;

    font-weight:600;
}

/* Location */
.location{
    color:#777;
    font-size:14px;

    margin-bottom:14px;

    display:flex;
    align-items:center;

    gap:6px;
}

/* Price */
.price{
    font-size:20px;
    font-weight:700;
    color:#ff385c;
}

.price span{
    color:#777;
    font-size:14px;
    font-weight:400;
}

/* ================= ACTION BUTTONS ================= */
.card-actions{
    display:flex;
    justify-content:space-between;
    align-items:center;

    padding:18px 22px;

    border-top:1px solid #f0f0f0;

    background:#fafafa;
}

/* Buttons */
.edit-btn,
.delete-btn{
    border:none;
    outline:none;

    padding:10px 18px;

    border-radius:12px;

    font-size:14px;
    font-weight:500;

    cursor:pointer;

    transition:0.3s ease;

    text-decoration:none;
}

/* Edit */
.edit-btn{
    background:#22c55e;
    color:white;
}

.edit-btn:hover{
    background:#16a34a;

    transform:translateY(-2px);

    box-shadow:0 8px 20px rgba(34,197,94,0.25);
}

/* Delete */
.delete-btn{
    background:#ef4444;
    color:white;
}

.delete-btn:hover{
    background:#dc2626;

    transform:translateY(-2px);

    box-shadow:0 8px 20px rgba(239,68,68,0.25);
}

/* ================= RESPONSIVE ================= */
@media(max-width:768px){

    .heading{
        font-size:28px;
    }

    .grid{
        padding:25px 18px 50px;
        gap:24px;
    }

    .card-img img{
        height:210px;
    }

    .card-body h3{
        font-size:20px;
    }

    .price{
        font-size:18px;
    }
}
.no-result{

    text-align:center;

    padding:100px 20px;
}

.no-result h2{

    font-size:42px;

    margin-bottom:15px;

    color:#111827;
}

.no-result p{

    color:#6b7280;

    font-size:18px;
}
</style>

<body>

   <%- include("include/navbar.ejs") %>
   <%-include("include/flash.ejs")%>

    <h2 class="heading">Explore Listings</h2>
        <% if(info.length === 0){ %>

  <div class="no-result">

    <h2>No Listings Found..</h2>

    <p>
      Try searching another destination
    </p>

  </div>

<% } %>
    <div class="grid">
    <% for(let i of info){ %>
        <div class="card">

            <!-- Clickable Area -->
            <a href="/listing/<%= i._id %>" class="card-link">
                <div class="card-img">
                    <img src="<%= i.image.url %>" alt="image">
                </div>

                <div class="card-body">
                    <h3><%= i.title %></h3>
                    <p class="location">📍 <%= i.location %>, <%= i.country %></p>
                    <h3 class="price">
  ₹<%= i.price.toLocaleString("en-IN") %>
  <span>/ night</span>
</h3>
                </div>
            </a>


        </div>
    <% } %>
</div>
    <%- include("include/footer.ejs") %>

</body>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
<script src="/script.js"></script>
</html>